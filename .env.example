# Copy to .env.local and fill in what you have. Every integration below is
# optional at dev time — the app degrades gracefully (mocked/empty data,
# disabled AI features) when a var is missing. See src/lib/supabase/client.ts
# (isSupabaseConfigured) and the guards in src/app/api/**/route.ts.

# --- Supabase --------------------------------------------------------------
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, never expose to the browser. Used by the
# ingestion pipeline and seed script to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ---------------------------------------------------------
# platform.claude.com → API Keys. Powers NL search, outreach drafting, and
# document generation. All three routes return a "fallback"/plain response
# when this is unset.
ANTHROPIC_API_KEY=

# --- YouTube Data API v3 ----------------------------------------------
# console.cloud.google.com → enable "YouTube Data API v3" → Credentials.
# Free tier: 10,000 quota units/day, no billing required.
YOUTUBE_API_KEY=

# --- Google OAuth (creator claim-your-page verification) ---------------
# Same GCP project as above. Add the YouTube readonly scope to the OAuth
# consent screen. Redirect URI: <origin>/api/claim/youtube/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Cron -----------------------------------------------------------------
# Shared secret checked by src/app/api/cron/refresh/route.ts (Vercel Cron
# sends it as a Bearer token automatically when configured in vercel.json).
CRON_SECRET=

# --- Resend (optional outbound email notifications) ------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="LinkedIn for Influencers <notifications@example.com>"

NEXT_PUBLIC_SITE_URL=http://localhost:3000
